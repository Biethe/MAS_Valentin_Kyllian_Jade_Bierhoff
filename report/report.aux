\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Infrastructure}{3}{subsection.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Local inference through Ollama.}{3}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{One model, \texttt  {llama3.1:8b}, for every role.}{3}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Deterministic decoding (temperature 0, fixed seed) and a 1024-token cap.}{4}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mailbox behind MCP, with no send tool.}{4}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Java 21 without an agent framework.}{4}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Organization}{4}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Router plus specialists, with specialists as data files.}{4}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{LLM routing over agent descriptions.}{4}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Autonomous specialists (tool loop) rather than a fixed workflow.}{4}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Native tool calling and JSON answers rather than parsing free text.}{5}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Interaction}{5}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A mediator (the coordinator) for every exchange.}{5}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A separate opponent with an opposite goal, rather than self-critique.}{5}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Bounded argumentation: two attacks, then the coordinator commits.}{5}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Norms enforced by the coordinator: search before proposing, no empty proposal.}{5}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Memory and retrieval}{5}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Lessons learned only from lost arguments, stored per agent, five most recent recalled.}{5}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{RAG over the mailbox only, from snippets, with a small embedding model.}{6}{section*.22}\protected@file@percent }
